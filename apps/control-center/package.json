{
  "name": "@514cc/control-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --experimental-sqlite server.mjs",
    "dev": "node --experimental-sqlite server.mjs --dev",
    "test": "node scripts/run-tests.mjs",
    "ui:lint": "node scripts/ui-lint.mjs",
    "ui:lint:baseline": "node scripts/ui-lint.mjs --update-baseline",
    "ui:codemod": "node scripts/ui-tokens.mjs report",
    "ui:codemod:apply": "node scripts/ui-tokens.mjs apply",
    "ui:report": "node scripts/ui-audit-report.mjs",
    "probe": "node scripts/probe-clis.mjs",
    "probe:codex-protocol": "node scripts/probe-codex-protocol.mjs",
    "sync:ccswitch-presets": "node --experimental-loader ./scripts/ccswitch-ts-loader.mjs ./scripts/import-ccswitch-presets.mjs --write",
    "sync:ccswitch-ledger": "node scripts/validate-ccswitch-migration.mjs --write",
    "validate:ccswitch": "node scripts/validate-ccswitch-migration.mjs",
    "qa:ui": "node scripts/qa-ui-fixture.mjs",
    "qa:bot-p0": "node scripts/qa-bot-p0.mjs",
    "qa:bot-collab-dialog": "node scripts/qa-bot-collab-dialog.mjs",
    "qa:permission-approval": "node scripts/qa-permission-approval.mjs",
    "qa:team": "node scripts/qa-team-workspace.mjs",
    "qa:environment": "node scripts/qa-workbench-environment.mjs",
    "qa:cli-seats": "node scripts/run-cli-seat-qa.mjs",
    "qa:config-topology": "node scripts/qa-config-topology.mjs",
    "qa:remote-config": "node scripts/qa-remote-config.mjs",
    "validate": "node scripts/validate-control-configs.mjs",
    "schema:generate": "node scripts/generate-event-schema.mjs",
    "smoke:collaboration": "node scripts/smoke-collaboration.mjs",
    "qa:walkthrough": "node scripts/qa-config-walkthrough.mjs",
    "qa:delivery": "node scripts/qa-delivery-manifest.mjs",
    "qa:delivery:desktop": "node scripts/qa-delivery-manifest.mjs --desktop"
  },
  "devDependencies": {
    "lucide": "^0.511.0",
    "playwright": "1.61.1"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "highlight.js": "^11.11.1",
    "json5": "^2.2.3",
    "node-pty": "^1.1.0",
    "pptxgenjs": "^4.0.1",
    "ssh2": "^1.17.0",
    "undici": "^7.29.0",
    "yaml": "^2.9.0",
    "yauzl": "^3.4.0"
  }
}
